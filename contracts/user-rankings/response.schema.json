{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "user-rankings-v1"
    },
    "cohort_policy_version": {
      "type": "string",
      "const": "single-date-v1"
    },
    "dataset_version": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "reporters",
            "fines",
            "unlucky"
          ]
        },
        "metric": {
          "type": "string",
          "enum": [
            "reports_count",
            "fine_count",
            "fine_rate",
            "rejected_count",
            "rejected_rate",
            "partial_count",
            "partial_rate"
          ]
        },
        "period": {
          "type": "string",
          "enum": [
            "all",
            "range",
            "month"
          ]
        },
        "start": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "month": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_basis": {
          "type": "string",
          "enum": [
            "report_date",
            "completed_date"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "all",
            "traffic",
            "parking",
            "other"
          ]
        },
        "min_reports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "timezone": {
          "type": "string",
          "const": "Asia/Seoul"
        },
        "in_progress": {
          "type": "boolean"
        }
      },
      "required": [
        "theme",
        "metric",
        "period",
        "start",
        "end",
        "month",
        "date_basis",
        "category",
        "min_reports",
        "timezone",
        "in_progress"
      ],
      "additionalProperties": false
    },
    "total_participants": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "tie_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "reports": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "fine": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "rejected": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "partial": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "completed_unknown": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "numerator": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "denominator": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "is_me": {
            "type": "boolean"
          }
        },
        "required": [
          "uuid",
          "rank",
          "tie_count",
          "reports",
          "fine",
          "rejected",
          "partial",
          "completed_unknown",
          "numerator",
          "denominator",
          "value",
          "is_me"
        ],
        "additionalProperties": false
      }
    },
    "me": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "uuid": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "rank": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "tie_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "reports": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "fine": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rejected": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "partial": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completed_unknown": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "numerator": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "denominator": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "is_me": {
              "type": "boolean"
            }
          },
          "required": [
            "uuid",
            "rank",
            "tie_count",
            "reports",
            "fine",
            "rejected",
            "partial",
            "completed_unknown",
            "numerator",
            "denominator",
            "value",
            "is_me"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "page": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "next_page": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "selected_date_missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed_unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inconsistent_disposition": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "selected_date_missing",
        "completed_unknown",
        "inconsistent_disposition"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "cohort_policy_version",
    "dataset_version",
    "generated_at",
    "scope",
    "total_participants",
    "rows",
    "me",
    "page",
    "page_size",
    "next_page",
    "diagnostics"
  ],
  "additionalProperties": false
}
