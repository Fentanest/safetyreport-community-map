{
  "contract": "list-refetch-v1",
  "rule": "refetch = not in_personal_detail OR coalesce(closed,'') != 'Y' OR supplement_open == 'Y' OR (detail_status_label is null AND not rebuild_failed_permanent) OR list_label != detail_status_label. closed/supplement_open = site values (personal overrides ignored); list_label = current list C_NOW label (after this crawl's list update); detail_status_label = community.db detail_status (label seen in the last successful detail capture).",
