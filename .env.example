# Public frontend settings. These are visible to every browser.
VITE_KAKAO_MAP_JS_KEY=
VITE_PUBLIC_ANALYTICS_URL=
VITE_DATA_MODE=demo
VITE_BASE_PATH=/safetyreport-community-map/
# Do NOT put REST keys, DSNs, service_role, or refresh tokens in VITE_*.

# safeauth central page (public build values only; see docs/safeauth/deployment.md)
# SAFEAUTH_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# SAFEAUTH_PUBLIC_PUBLISHABLE_KEY=sb_publishable_...
# SAFEAUTH_PUBLIC_PRIVACY_POLICY_URL=https://...
# Relay secrets (AUTH_RELAY_HASH_PEPPER, AUTH_RELAY_ENCRYPTION_KEY) go to Supabase Edge secrets only, never here.
