# Public frontend settings. These are visible to every browser.
VITE_KAKAO_MAP_JS_KEY=
VITE_PUBLIC_ANALYTICS_URL=
VITE_DATA_MODE=demo
VITE_BASE_PATH=/
# Optional map web login (personal comparison). Public values only: project URL + publishable (anon) key.
# Leave empty to ship the public map without login (the toggle shows "로그인 미설정").
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Do NOT put REST keys, DSNs, service_role, secret keys or refresh tokens in VITE_*.
