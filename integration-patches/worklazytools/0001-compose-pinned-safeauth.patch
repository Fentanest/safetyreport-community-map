From cd87a95dc255915a58eb4aa333fab8dbe137a714 Mon Sep 17 00:00:00 2001
From: Fentanest <noreply@invalid>
Date: Fri, 25 Sep 2026 23:15:39 +0900
Subject: [PATCH] Compose the pinned community-map /safeauth/ build into the
 Pages artifact

---
 .github/safeauth-pin.json          |  8 ++++++
 .github/workflows/deploy-pages.yml | 46 ++++++++++++++++++++++++++++++
 2 files changed, 54 insertions(+)
 create mode 100644 .github/safeauth-pin.json

diff --git a/.github/safeauth-pin.json b/.github/safeauth-pin.json
new file mode 100644
index 0000000..bdacff2
--- /dev/null
+++ b/.github/safeauth-pin.json
@@ -0,0 +1,8 @@
+{
+  "schemaVersion": 1,
+  "enabled": false,
+  "repository": "Fentanest/safetyreport-community-map",
+  "commit": "0000000000000000000000000000000000000000",
+  "protocolVersion": 1,
+  "mount": "safeauth"
+}
diff --git a/.github/workflows/deploy-pages.yml b/.github/workflows/deploy-pages.yml
index 3623452..2655b69 100644
--- a/.github/workflows/deploy-pages.yml
+++ b/.github/workflows/deploy-pages.yml
@@ -71,6 +71,52 @@ jobs:
       - name: Verify the small hybrid video route
         run: npm run test:video-hybrid
 
+      # /safeauth/ (community account link) is built from the community-map commit pinned in
+      # .github/safeauth-pin.json and composed into dist AFTER this site's own checks, so
+      # those checks are unchanged. Its source lives only in Fentanest/safetyreport-community-map.
+      - name: Read safeauth pin
+        id: safeauth
+        run: |
+          node -e '
+            const pin = require("./.github/safeauth-pin.json");
+            const sha = String(pin.commit || "");
+            const valid = pin.schemaVersion === 1
+              && pin.repository === "Fentanest/safetyreport-community-map"
+              && /^[0-9a-f]{40}$/.test(sha) && !/^0+$/.test(sha);
+            if (pin.enabled === true && !valid) { console.error("safeauth pin is enabled but invalid"); process.exit(1); }
+            console.log("enabled=" + (pin.enabled === true));
+            console.log("sha=" + (valid ? sha : ""));
+          ' >> "$GITHUB_OUTPUT"
+
+      - name: Checkout pinned safeauth source
+        if: steps.safeauth.outputs.enabled == 'true'
+        uses: actions/checkout@v4
+        with:
+          repository: Fentanest/safetyreport-community-map
+          ref: ${{ steps.safeauth.outputs.sha }}
+          path: .safeauth-src
+          token: ${{ secrets.SAFEAUTH_SOURCE_TOKEN }}
+          persist-credentials: false
+
+      - name: Build and compose /safeauth/
+        if: steps.safeauth.outputs.enabled == 'true'
+        working-directory: .safeauth-src
+        env:
+          SAFEAUTH_SHA: ${{ steps.safeauth.outputs.sha }}
+          SAFEAUTH_PUBLIC_SUPABASE_URL: ${{ vars.SAFEAUTH_PUBLIC_SUPABASE_URL }}
+          SAFEAUTH_PUBLIC_PUBLISHABLE_KEY: ${{ vars.SAFEAUTH_PUBLIC_PUBLISHABLE_KEY }}
+          SAFEAUTH_PUBLIC_PRIVACY_POLICY_URL: ${{ vars.SAFEAUTH_PUBLIC_PRIVACY_POLICY_URL }}
+          SAFEAUTH_PUBLIC_OPERATOR_CONTACT: ${{ vars.SAFEAUTH_PUBLIC_OPERATOR_CONTACT }}
+        run: |
+          test "$(git rev-parse HEAD)" = "$SAFEAUTH_SHA"
+          npm ci --no-audit --no-fund
+          npm run build:safeauth
+          node scripts/safeauth/compose-into-site.mjs --site-dist ../dist --auth-dist dist-safeauth \
+            --source-sha "$SAFEAUTH_SHA" --require-config --expect-supabase "$SAFEAUTH_PUBLIC_SUPABASE_URL" \
+            --report ../safeauth-compose-report.json
+          node scripts/safeauth/verify-composed-site.mjs --site-dist ../dist
+          { echo "### /safeauth/"; echo "- source: Fentanest/safetyreport-community-map@$SAFEAUTH_SHA"; echo "- protocol: 1"; } >> "$GITHUB_STEP_SUMMARY"
+
       - name: Upload Pages artifact
         uses: actions/upload-pages-artifact@v3
         with:
-- 
2.43.0

